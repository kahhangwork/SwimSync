# SwimSync admin panel — Supabase connection
# Values from `supabase start` (local) or the dashboard (cloud).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser or commit a real value.
# Used by the create-coach API route (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret used to authenticate the generate-invoices Edge Function.
# Must match supabase/functions/.env (local) or the deployed function secret.
CRON_SECRET=local-dev-cron-secret

# Where the PARENT app lives. Used to build the accept-invite link when an admin
# invites the parent of a child a coach added (PRD §7.17). It must point at the
# mobile app, NOT this panel — a parent has no business on the admin site.
#
# Whatever is set here must ALSO appear verbatim in
# [auth].additional_redirect_urls in supabase/config.toml (and in the Supabase
# dashboard for production). An unlisted redirect is not rejected: Supabase
# silently substitutes site_url, so the invite arrives and lands on the wrong
# site — see HANDOVER §7.41.
# Local: http://localhost:8081   Production: https://swimsync.sg
NEXT_PUBLIC_APP_URL=http://localhost:8081
