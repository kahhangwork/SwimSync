{
  "permissions": {
    "allow": [
      "Bash(supabase status*)",
      "Bash(supabase projects list*)",
      "Bash(supabase migration list*)",
      "Bash(supabase functions list*)",
      "Bash(supabase db dump*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-stash.sh\"",
            "statusMessage": "Checking for git stash"
          }
        ]
      }
    ]
  }
}
